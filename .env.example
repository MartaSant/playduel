# Copy this file to .env.local and replace the placeholders.
# .env.local stays untracked. Do not put real secrets in this example.
#
# The app reads only the two public values below. Placeholders count as unset.
# Never prefix a service-role key with NEXT_PUBLIC_. The app does not use one.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
