# Copy this file to .env.local and replace the placeholders.
# .env.local stays untracked. Do not put real secrets in this example.
#
# These names are reserved for Milestone 3 (Supabase). The app does not
# read them yet. Never prefix a service-role key with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never send this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
